          "output": "```python\n\"\"\"LRU Cache implementation with O(1) get and put operations.\"\"\"\n\nfrom collections import OrderedDict\nimport unittest\n\n\nclass LRUCache:\n    \"\"\"A Least Recently Used (LRU) cache with O(1) get and put operations.\n\n    Uses an OrderedDict to maintain insertion order, which reflects\n    recency of access. The most recently used item is at the end,\n    and the least recently used item is at the beginning.\n    \"\"\"\n\n    def __init__(self, capacity: int):\n        \"\"\"Initialize the LRU cache with the given capacity.\n\n        Args:\n            capacity: Maximum number of items the cache can hold.\n                      Must be a positive integer.\n\n        Raises:\n            ValueError: If capacity is less than or equal to zero.\n        \"\"\"\n        if capacity <= 0:\n            raise ValueError(\"Capacity must be a positive integer.\")\n        self._capacity = capacity\n        self._cache = OrderedDict()\n\n    def get(self, key) -> int:\n        \"\"\"Retrieve the value associated with the given key.\n\n        If the key exists, its recency is updated (moved to most recent).\n        If the key does not exist, returns -1.\n\n        Args:\n            key: The key to look up.\n\n        Returns:\n            The value associated with the key, or -1 if not found.\n        \"\"\"\n        if key not in self._cache:\n            return -1\n        # Move to end to mark as most recently used\n        self._cache.move_to_end(key)\n        return self._cache[key]\n\n    def put(self, key, value) -> None:\n        \"\"\"Insert or update a key-value pair in the cache.\n\n        If the key already exists, its value is updated and its recency\n        is refreshed. If the key does not exist and the cache is at\n        capacity, the least recently used item is evicted.\n\n        Args:\n            key: The key to insert or update.\n            value: The value to associate with the key.\n        \"\"\"\n        if key in self._cache:\n            # Update value and move to end (most recently used)\n            self._cache[key] = value\n            self._cache.move_to_end(key)\n        else:\n            # If at capacity, evict the least recently used item\n            if len(self._cache) >= self._capacity:\n                self._cache.popitem(last=False)\n            self._cache[key] = value\n\n\nclass TestLRUCache(unittest.TestCase):\n    \"\"\"Comprehensive test suite for LRUCache.\"\"\"\n\n    def test_invalid_capacity_zero(self):\n        \"\"\"Test that capacity=0 raises ValueError.\"\"\"\n        with self.assertRaises(ValueError):\n            LRUCache(0)\n\n    def test_invalid_capacity_negative(self):\n        \"\"\"Test that negative capacity raises ValueError.\"\"\"\n        with self.assertRaises(ValueError):\n            LRUCache(-1)\n\n    def test_put_and_get_existing_key(self):\n        \"\"\"Test basic put and get for an existing key.\"\"\"\n        cache = LRUCache(2)\n        cache.put(1, 10)\n        self.assertEqual(cache.get(1), 10)\n\n    def test_get_missing_key_returns_minus_one(self):\n        \"\"\"Test that get for a missing key returns -1.\"\"\"\n        cache = LRUCache(2)\n        self.assertEqual(cache.get(99), -1)\n\n    def test_eviction_of_least_recently_used(self):\n        \"\"\"Test that the least recently used item is evicted when capacity is exceeded.\"\"\"\n        cache = LRUCache(2)\n        cache.put(1, 10)\n        cache.put(2, 20)\n        # Access key 1 to make it most recently used\n        cache.get(1)\n        # Add key 3, should evict key 2 (least recently used)\n        cache.put(3, 30)\n        self.assertEqual(cache.get(2), -1)\n        self.assertEqual(cache.get(1), 10)\n        self.assertEqual(cache.get(3), 30)\n\n    def test_update_existing_key_refreshes_recency(self):\n        \"\"\"Test that updating an existing key refreshes its recency.\"\"\"\n        cache = LRUCache(2)\n        cache.put(1, 10)\n        cache.put(2, 20)\n        # Update key 1, making it most recently used\n        cache.put(1, 15)\n        # Add key 3, should evict key 2\n        cache.put(3, 30)\n        self.assertEqual(cache.get(2), -1)\n        self.assertEqual(cache.get(1), 15)\n        self.assertEqual(cache.get(3), 30)\n\n    def test_capacity_one(self):\n        \"\"\"Test cache with capacity of 1.\"\"\"\n        cache = LRUCache(1)\n        cache.put(1, 10)\n        self.assertEqual(cache.get(1), 10)\n        cache.put(2, 20)\n        self.assertEqual(cache.get(1), -1)\n        self.assertEqual(cache.get(2), 20)\n\n    def test_multiple_evictions(self):\n        \"\"\"Test multiple evictions in sequence.\"\"\"\n        cache = LRUCache(3)\n        cache.put(1, 10)\n        cache.put(2, 20)\n        cache.put(3, 30)\n        # Access key 1\n        cache.get(1)\n        # Add key 4, evicts key 2\n        cache.put(4, 40)\n        self.assertEqual(cache.get(2), -1)\n        # Access key 3\n        cache.get(3)\n        # Add key 5, evicts key 1\n        cache.put(5, 50)\n        self.assertEqual(cache.get(1), -1)\n        self.assertEqual(cache.get(3), 30)\n        self.assertEqual(cache.get(4), 40)\n        self.assertEqual(cache.get(5), 50)\n\n    def test_overwrite_does_not_increase_size(self):\n        \"\"\"Test that overwriting an existing key does not increase cache size.\"\"\"\n        cache = LRUCache(2)\n        cache.put(1, 10)\n        cache.put(2, 20)\n        # Overwrite key 1\n        cache.put(1, 15)\n        # Cache should still have 2 items\n        cache.put(3, 30)\n        # Key 2 should be evicted, not key 1\n        self.assertEqual(cache.get(2), -1)\n        self.assertEqual(cache.get(1), 15)\n        self.assertEqual(cache.get(3), 30)\n\n    def test_string_keys(self):\n        \"\"\"Test that string keys work correctly.\"\"\"\n        cache = LRUCache(2)\n        cache.put(\"a\", 1)\n        cache.put(\"b\", 2)\n        self.assertEqual(cache.get(\"a\"), 1)\n        cache.put(\"c\", 3)\n        self.assertEqual(cache.get(\"b\"), -1)\n        self.assertEqual(cache.get(\"a\"), 1)\n        self.assertEqual(cache.get(\"c\"), 3)\n\n    def test_large_capacity(self):\n        \"\"\"Test with a larger capacity to ensure correctness.\"\"\"\n        cache = LRUCache(10)\n        for i in range(10):\n            cache.put(i, i * 10)\n        # All keys should be present\n        for i in range(10):\n            self.assertEqual(cache.get(i), i * 10)\n        # Add one more, evicts key 0\n        cache.put(10, 100)\n        self.assertEqual(cache.get(0), -1)\n        for i in range(1, 11):\n            self.assertEqual(cache.get(i), i * 10)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n```",
